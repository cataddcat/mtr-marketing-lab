# Public proxy URL for the Cloudflare Worker that handles all LLM calls.
# All provider API keys (Groq, SambaNova) are stored as Worker secrets,
# never in the frontend bundle.
#
# Example values:
#   Local dev:   http://localhost:8787
#   Production:  https://mtr-marketing-lab-proxy.<account>.workers.dev
VITE_AI_PROXY_URL=

# ──────────────────────────────────────────────────────────────────
# Supabase — Track D1 (Online SaaS, multi-user)
# Leave EMPTY to run in local-only mode (no auth, no cloud sync).
# When configured, the app shows a SignInScreen and persists data per user.
#
# Get these from Supabase Studio → Project Settings → API.
# Run `supabase/migrations/0001_initial.sql` in Supabase Studio SQL Editor
# (or via `supabase db push`) before signing in for the first time.
# ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────
# MiroFish — Track E (Community Simulation, Sprint 3+)
# Leave EMPTY to hide the community-sim panel.
#
# Local default: http://localhost:5001
# Production: deploy MiroFish via Docker (see MIROFISH_SETUP.md)
# CORS is already enabled in MiroFish for any origin.
# ──────────────────────────────────────────────────────────────────
VITE_MIROFISH_URL=
